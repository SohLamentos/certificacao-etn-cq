# Ambiente de Desenvolvimento Local (AI Studio / Vite Dev Server)
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Vite / Cloudflare Pages
# Em produção no Cloudflare Pages, aponte para o Worker publicado:
# VITE_API_BASE_URL=https://etn-certificacao-cq-api.persistentesoficial365.workers.dev
# Em desenvolvimento local, deixar vazio para fallback em rota relativa ou proxy:
VITE_API_BASE_URL=

# Produção Cloudflare Worker:
# Utiliza Bindings nativos declarados no wrangler.toml:
# - DB: Cloudflare D1 (etn-certificacao-cq-db-prod)
# - MAT_API: Service Binding (etn-materiais-api)
# Não requer senhas locais ou tokens estáticos no .env

